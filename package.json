{
  "name": "@hexanti/gup",
  "version": "0.1.0",
  "private": true,
  "description": "Unified CLI to check and update packages across many sources (winget, npm-g, pnpm-g, scoop, choco, pip, pipx, dotnet tools, cargo, pwsh modules, composer global, vscode extensions, symfony-cli, gh extensions, jetbrains, az, yarn, wsl, pulumi, terraform, kubectl, krew, jetbrains plugins).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LINDECKER-Charles/GlobalUpdater.git"
  },
  "keywords": [
    "cli",
    "updater",
    "package-manager",
    "winget",
    "scoop",
    "npm",
    "dotnet",
    "windows"
  ],
  "bin": {
    "gup": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "ora": "^8.1.1",
    "p-limit": "^6.2.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/semver": "^7.5.8",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
