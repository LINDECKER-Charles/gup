{
  "name": "@charles_lindecker/gup",
  "version": "0.3.2",
  "private": false,
  "description": "gup (Global Updater) — one CLI to scan and update everything installed on your machine across 153 sources: winget, scoop, chocolatey, MSYS2, Cygwin, Homebrew (formulae + casks), MacPorts, Mac App Store, Nix, pkgx, npm-g, pnpm-g, yarn-g, bun, pip, pipx, uv, cargo, gem, .NET SDK + tools, NuGet, composer, helm, kubectl, krew, terraform, pulumi, az, gcloud, Visual Studio, vscode extensions, JetBrains, pwsh modules, gh extensions, symfony-cli, nvm, pyenv, WSL distros. Windows, macOS and Linux. Parallel scan, fail-soft, JSON output, --fast mode, surgical targeting.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lindecker-charles.github.io/gup/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LINDECKER-Charles/gup.git"
  },
  "bugs": {
    "url": "https://github.com/LINDECKER-Charles/gup/issues"
  },
  "funding": [
    {
      "type": "ko_fi",
      "url": "https://ko-fi.com/charleslindecker"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/LINDECKER-Charles"
    }
  ],
  "author": {
    "name": "Charles Lindecker",
    "url": "https://github.com/LINDECKER-Charles"
  },
  "keywords": [
    "cli",
    "updater",
    "package-manager",
    "global-updater",
    "winget",
    "scoop",
    "chocolatey",
    "homebrew",
    "brew",
    "macports",
    "mas",
    "nix",
    "msys2",
    "cygwin",
    "npm-global",
    "pip",
    "pipx",
    "cargo",
    "helm",
    "kubectl",
    "terraform",
    "dotnet-sdk",
    "dotnet-tools",
    "nuget",
    "nvm",
    "pyenv",
    "visual-studio",
    "pwsh",
    "vscode-extensions",
    "windows",
    "macos",
    "linux",
    "wsl",
    "devops"
  ],
  "bin": {
    "gup": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "lint": "eslint src",
    "lint:security": "eslint src --config eslint.config.security.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:deps:ci": "audit-ci --config audit-ci.json",
    "security": "npm run audit:deps:ci && npm run lint:security && npm run test:security"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "adm-zip": "^0.6.0",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "ora": "^9.4.1",
    "p-limit": "^7.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "audit-ci": "^7.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-security": "^4.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
