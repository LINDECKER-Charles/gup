{
  "name": "@charles_lindecker/gup",
  "version": "0.5.3",
  "private": false,
  "description": "gup (Global Updater) — one CLI to scan and update everything installed on your machine across 153 sources: winget, scoop, chocolatey, MSYS2, Cygwin, Homebrew (formulae + casks), MacPorts, Mac App Store, Nix, pkgx, npm-g, pnpm-g, yarn-g, bun, pip, pipx, uv, cargo, gem, .NET SDK + tools, NuGet, composer, helm, kubectl, krew, terraform, pulumi, az, gcloud, Visual Studio, vscode extensions, JetBrains, pwsh modules, gh extensions, symfony-cli, nvm, pyenv, WSL distros. Windows, macOS and Linux. Parallel scan, fail-soft, JSON output, --fast mode, surgical targeting.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lindecker-charles.github.io/gup/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LINDECKER-Charles/gup.git"
  },
  "bugs": {
    "url": "https://github.com/LINDECKER-Charles/gup/issues"
  },
  "funding": [
    {
      "type": "ko_fi",
      "url": "https://ko-fi.com/charleslindecker"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/LINDECKER-Charles"
    }
  ],
  "author": {
    "name": "Charles Lindecker",
    "url": "https://github.com/LINDECKER-Charles"
  },
  "keywords": [
    "cli",
    "updater",
    "package-manager",
    "global-updater",
    "winget",
    "scoop",
    "chocolatey",
    "homebrew",
    "brew",
    "macports",
    "mas",
    "nix",
    "msys2",
    "cygwin",
    "npm-global",
    "pip",
    "pipx",
    "cargo",
    "helm",
    "kubectl",
    "terraform",
    "dotnet-sdk",
    "dotnet-tools",
    "nuget",
    "nvm",
    "pyenv",
    "visual-studio",
    "pwsh",
    "vscode-extensions",
    "windows",
    "macos",
    "linux",
    "wsl",
    "devops"
  ],
  "bin": {
    "gup": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "typecheck:scripts": "tsc -p scripts/screenshots",
    "test": "vitest --project unit --project \"providers*\"",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit --project \"providers*\"",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "npm run build && node --env-file=tests/e2e/opt-in.env node_modules/vitest/vitest.mjs run --project e2e",
    "test:e2e:smoke": "npm run build && node --env-file=tests/e2e/opt-in-smoke.env node_modules/vitest/vitest.mjs run --project e2e",
    "test:e2e:mutate": "npm run build && node --env-file=tests/e2e/opt-in-mutate.env node_modules/vitest/vitest.mjs run --project e2e",
    "fixtures:record": "tsx scripts/fixtures/record.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "lint": "eslint --no-error-on-unmatched-pattern src tests scripts",
    "lint:security": "eslint src --config .github/eslint.config.security.js",
    "screenshots": "vitest run --config scripts/screenshots/vitest.config.ts",
    "screenshots:check": "vitest run --config scripts/screenshots/vitest.config.ts --mode check",
    "screenshots:report": "npm run build && tsx scripts/screenshots/report-sample.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:deps:ci": "audit-ci --config .github/audit-ci.json",
    "security": "npm run audit:deps:ci && npm run lint:security && npm run test:security"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "dependencies": {
    "@opentui/core": "0.5.14",
    "adm-zip": "^0.6.1",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "croner": "10.0.1",
    "execa": "^10.0.1",
    "p-limit": "^7.3.3",
    "semver": "^7.8.5"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@xterm/headless": "6.0.0",
    "audit-ci": "^7.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.2.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
