{
  "name": "@charles_lindecker/gup",
  "version": "0.2.0",
  "private": false,
  "description": "gup (Global Updater) — one CLI to scan and update everything installed on your machine across ~130 sources: winget, scoop, chocolatey, npm-g, pnpm-g, yarn-g, bun, pip, pipx, uv, cargo, gem, dotnet tools, composer, helm, kubectl, krew, terraform, pulumi, az, gcloud, vscode extensions, JetBrains, pwsh modules, gh extensions, symfony-cli, WSL distros. Parallel scan, fail-soft, JSON output, --fast mode, surgical targeting.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lindecker-charles.github.io/gup/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LINDECKER-Charles/gup.git"
  },
  "bugs": {
    "url": "https://github.com/LINDECKER-Charles/gup/issues"
  },
  "funding": [
    {
      "type": "ko_fi",
      "url": "https://ko-fi.com/charleslindecker"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/LINDECKER-Charles"
    }
  ],
  "author": {
    "name": "Charles Lindecker",
    "url": "https://github.com/LINDECKER-Charles"
  },
  "keywords": [
    "cli",
    "updater",
    "package-manager",
    "global-updater",
    "winget",
    "scoop",
    "chocolatey",
    "npm-global",
    "pip",
    "pipx",
    "cargo",
    "helm",
    "kubectl",
    "terraform",
    "dotnet-tools",
    "pwsh",
    "vscode-extensions",
    "windows",
    "wsl",
    "devops"
  ],
  "bin": {
    "gup": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "lint": "eslint src",
    "lint:security": "eslint src --config eslint.config.security.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:deps:ci": "audit-ci --config audit-ci.json",
    "security": "npm run audit:deps:ci && npm run lint:security && npm run test:security"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "ora": "^8.1.1",
    "p-limit": "^6.2.0",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "audit-ci": "^7.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-security": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
