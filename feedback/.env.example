# Production settings, as the FEEDBACK_ENV_FILE secret holds them: the deploy
# job writes this content to /opt/gup-feedback-prod/.env and appends IMAGE_TAG.
# Compose interpolates `$` in this file: no generated value may contain one
# (the password hash format and base64url/hex secrets never do).
# For local development, see dev.env in README.md instead.

# ── required ────────────────────────────────────────────────────────────────
# Database password: letters and digits only, it is embedded in a URL.
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
# printf '%s' "$PASSWORD" | npm run -s admin:hash
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
# The authenticator app's key (second factor): npm run -s admin:totp -- secret
ADMIN_TOTP_SECRET=
FEEDBACK_PUBLIC_URL=https://feedback.example.com
# Domain(s) the shared Caddy edge routes to the service, comma-separated.
CADDY_DOMAINS=feedback.example.com

# ── optional ────────────────────────────────────────────────────────────────
# Landing page the no-JavaScript form returns to when its returnTo is not allowed.
FEEDBACK_LANDING_URL=
# Origins allowed to post feedback (CORS); defaults to the landing's origin.
FEEDBACK_ALLOWED_ORIGINS=
# Unset: feedback is accepted, its notification mail waits in the outbox.
SMTP_URL=
MAIL_FROM=
FEEDBACK_NOTIFY_TO=
LOG_RETENTION_DAYS=
LOG_LEVEL=
