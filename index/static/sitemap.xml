<?xml version="1.0" encoding="UTF-8"?>
<!--
  Single-page landing — only the canonical /gup/ URL belongs here.

  Removed (and why):
    - Fragment URLs (#problem, #modes, ...): Google strips fragments before
      deduplication, so each entry resolved to /gup/ and surfaced as
      "Page with duplicate URL" in Search Console.
    - External URLs (github.com, npmjs.com): a sitemap declares pages YOU
      control. External URLs are ignored by all major crawlers.
    - <image:image> blocks: the referenced /gup/screenshots/*.png files
      are not committed yet — add them back once the screenshots land.

  lastmod is rewritten at deploy time by .github/workflows/pages.yml
  (see "Inject build metadata" step) — the @@LASTMOD@@ placeholder
  stays in source so local builds remain deterministic.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://lindecker-charles.github.io/gup/</loc>
    <lastmod>@@LASTMOD@@</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
